#!/usr/bin/bash
# SPDX-FileCopyrightText: 2026 Cypress Reed <cypress@fyralabs.com>
#
# SPDX-License-Identifier: GPL-3.0-only

set -euo pipefail

link=${ULTRAMARINE_DGPU_LINK:-@DGPU_RUNTIME_LINK@}
target=@DGPU_ACTION_FILE@
drm=${ULTRAMARINE_DGPU_DRM_DIR:-/sys/class/drm}

default_discrete=0
default_found=0
other_discrete=0

is_connector() { [[ ${1##*/} == *-* ]]; }

for card in "$drm"/card[0-9]*; do
    is_connector "$card" && continue
    [[ -e $card/device ]] || continue

    boot_vga=0
    [[ -r $card/device/boot_vga ]] && boot_vga=$(<"$card/device/boot_vga")

    # captured first so grep -q can't SIGPIPE udevadm under pipefail
    discrete=0
    properties=$(udevadm info --query=property --path="$card" 2>/dev/null) || properties=
    if grep -Eq '^(CURRENT_)?TAGS=.*:switcheroo-discrete-gpu:' <<<"$properties"; then
        discrete=1
    fi

    if [[ $boot_vga == 1 && $default_found == 0 ]]; then
        default_found=1
        default_discrete=$discrete
    elif [[ $discrete == 1 ]]; then
        other_discrete=1
    fi
done

hybrid=0
if [[ $default_found == 1 && $default_discrete == 0 && $other_discrete == 1 ]]; then
    hybrid=1
fi

if [[ ${1:-} == --check ]]; then
    if [[ $hybrid == 1 ]]; then
        echo "hybrid: the action is shown"
        exit 0
    fi
    echo "not hybrid: the action is hidden"
    exit 1
fi

if [[ $hybrid == 1 ]]; then
    mkdir -p "${link%/*}"
    ln -sfn "$target" "$link"
else
    rm -f "$link"
fi
