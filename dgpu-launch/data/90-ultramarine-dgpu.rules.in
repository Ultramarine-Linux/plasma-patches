# restart, so an event during a running check still gets a fresh one
ACTION=="add|remove", SUBSYSTEM=="drm", KERNEL=="card[0-9]|card[0-9][0-9]", RUN+="@SYSTEMCTL_EXECUTABLE@ --no-block restart ultramarine-dgpu-detect.service"
