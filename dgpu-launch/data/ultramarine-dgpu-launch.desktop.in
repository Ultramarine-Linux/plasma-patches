# Plasma launcher drop-in action (see plasma/kickeractions).
# Plasma passes the app's desktop file as %u (a local path). ultramarine-dgpu-launch
# runs its Exec line with the discrete GPU's environment from switcheroo-control
# (DRI_PRIME, NVIDIA PRIME offload, Vulkan driver selection). It doesn't go through
# KIO's D-Bus activation, which would drop that environment.
[Desktop Entry]
Type=Service
Name=Launch Using Dedicated Graphics Card
Actions=launchOnDgpu

[Desktop Action launchOnDgpu]
Name=Launch Using Dedicated Graphics Card
Icon=video-display
Exec=@DGPU_LAUNCH_EXECUTABLE@ %u
