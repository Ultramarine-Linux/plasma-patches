#!/bin/sh
# SPDX-FileCopyrightText: 2026 Cypress Reed <cypress@fyralabs.com>
#
# SPDX-License-Identifier: GPL-3.0-only

set -u

# systemctl inherits this, so a closed pipe after System Settings quits can't stop it mid-change
trap '' PIPE

PATH=/usr/bin:/usr/sbin:/bin:/sbin
export PATH

unit=geoclue.service

case "${1-}" in
enable)
    systemctl unmask "$unit" && systemctl unmask --runtime "$unit"
    ;;
disable)
    systemctl mask --force --now "$unit"
    ;;
*)
    echo "usage: $0 enable|disable" >&2
    exit 2
    ;;
esac
status=$?

pkexec_dismissed=126
pkexec_not_authorized=127
if [ "$status" -eq "$pkexec_dismissed" ] || [ "$status" -eq "$pkexec_not_authorized" ]; then
    status=1
fi
exit "$status"
