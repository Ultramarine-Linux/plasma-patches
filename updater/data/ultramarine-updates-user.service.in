[Unit]
Description=Install your updates automatically, or notify about pending updates
Documentation=https://github.com/Ultramarine-Linux/plasma-patches

[Service]
Type=oneshot
ExecStart=@ULTRAMARINE_UPDATES_EXECUTABLE@ run-user
Nice=19
IOSchedulingClass=idle
