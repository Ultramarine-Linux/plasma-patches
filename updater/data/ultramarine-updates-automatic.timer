[Unit]
Description=Install updates automatically when the device isn't in use
Documentation=https://github.com/Ultramarine-Linux/plasma-patches

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
AccuracySec=1min

[Install]
WantedBy=timers.target
