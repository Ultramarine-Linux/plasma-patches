<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SPDX-FileCopyrightText: 2026 Cypress Reed <cypress@fyralabs.com> -->
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<!-- an action without exec.argv1 matches every helper command, so every action needs one -->
<policyconfig>
  <vendor>Ultramarine Linux</vendor>
  <vendor_url>https://ultramarine-linux.org</vendor_url>
  <action id="org.ultramarine.updates.manage">
    <description>Install system updates</description>
    <message>Authentication is required to install updates</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@ULTRAMARINE_UPDATES_EXECUTABLE@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">apply</annotate>
  </action>
  <action id="org.ultramarine.updates.settings">
    <description>Change automatic update settings</description>
    <message>Authentication is required to change update settings</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@ULTRAMARINE_UPDATES_EXECUTABLE@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">settings</annotate>
  </action>
  <action id="org.ultramarine.updates.schedule">
    <description>Schedule system updates</description>
    <message>Authentication is required to schedule updates</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@ULTRAMARINE_UPDATES_EXECUTABLE@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">schedule</annotate>
  </action>
</policyconfig>
